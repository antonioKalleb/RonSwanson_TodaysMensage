<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mensagem do Dia - Ron Swanson</title>
    <!-- Importando o Bootstrap via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex flex-column justify-content-center align-items-center vh-100">

    <div class="container text-center">
        <div class="card shadow p-5 mx-auto" style="max-width: 600px;">
            <h1 class="mb-4 text-primary">Mensagem do Dia 🍖</h1>
            <blockquote class="blockquote">
                <p class="mb-4">"<%= mensagem %>"</p>
            </blockquote>
            <footer class="blockquote-footer text-muted">Ron Swanson</footer>
            
            <div class="mt-4">
                <!-- Botão para atualizar a página e ver outra frase -->
                <a href="/" class="btn btn-dark">Nova Frase</a>
            </div>
        </div>
    </div>

</body>
</html>